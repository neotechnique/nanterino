# Large or machine-specific files stay out of git (models are re-downloadable, venv is rebuildable).
media/*.wav
models/
models/piper/*.onnx
*.pyc
__pycache__/
song/build/
.venv/

# Persistent graph variables (lot L11): live values, machine-specific
state/

# Graph PNG exports (lot L14): cache of the editor "Exporter l'image" captures, regenerated on demand
exports/
fiches/.corbeille/
